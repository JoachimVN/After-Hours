<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.ntnu.idatt2003.g23</groupId>
  <artifactId>after-hours</artifactId>
  <version>1.2.4-beta.2</version>

  <name>After Hours</name>
  <url>https://git.ntnu.no/Gruppe-23/idatt2003_2026_23</url>
  
  <!-- Release process:
       1. Go to GitHub Releases
       2. Click "Draft a new release"
       3. Create a new tag (e.g., v1.0.0, v1.0.0-beta.1)
       4. Choose target branch (usually main/dev)
       5. Click "Generate release notes" (optional)
       6. Click "Publish release"
       Result: Automated workflow builds Windows .exe, portable .zip, updates version, and uploads assets.
  -->

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <javafx.platform.classifier>win</javafx.platform.classifier>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>25.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>25.0.1</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.0.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- All resources unfiltered (avoids corrupting binary files like images) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <!-- version.properties filtered so ${project.version} is substituted at build time -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>version.properties</include>
        </includes>
      </resource>
    </resources>

    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
              <source>25</source>
              <target>25</target>
          </configuration>
          </plugin>

            <!-- Surefire (JUnit 5 support is built-in) -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.5.4</version>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc.plugin</artifactId>
              <version>3.12.0</version>
            </plugin>

            <!-- Development: mvn javafx:run -->
            <plugin>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-maven-plugin</artifactId>
              <version>0.0.8</version>
              <configuration>
                <mainClass>edu.ntnu.idatt2003.g23.App</mainClass>
                <options>
                  <option>--enable-native-access=javafx.graphics,javafx.media</option>
                  <option>-Dglass.win.uiScale=1.25</option>
                  <option>-Dglass.gtk.uiScale=1.25</option>
                  <option>-Dglass.mac.uiScale=1.25</option>
                </options>
              </configuration>
            </plugin>
      </plugins>
    </pluginManagement>

    <!-- Plugins that are actively bound to lifecycle phases or run on demand -->
    <plugins>

      <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>edu.ntnu.idatt2003.g23.Launcher</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                </manifestEntries>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

      <!--
        Distribution exe: native installer via jpackage.
        Produces a native package for the current OS.
        The installer bundles a JRE; recipients need nothing pre-installed.

        Run after mvn package with one of:
        - mvn exec:exec@jpackage       (Windows EXE)
        - mvn exec:exec@jpackage-linux (Linux app-image)
        - mvn exec:exec@jpackage-mac   (macOS app-image)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>jpackage</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>exe</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.ico</argument>
                <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.win.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                <argument>--win-dir-chooser</argument>
                <argument>--win-shortcut</argument>
                <argument>--win-shortcut-prompt</argument>
                <argument>--win-menu</argument>
                <argument>--win-menu-group</argument><argument>After Hours</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-linux</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>app-image</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.png</argument>
                <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.gtk.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-mac</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>-c</argument>
                <argument>rm -rf "${java.io.tmpdir}/afterhours-dist/After Hours.app" &amp;&amp; jpackage --type app-image --name "After Hours" --app-version ${project.version} --vendor NTNU --description "After Hours" --icon "${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.icns" --input "${project.build.directory}/jpackage-input" --main-jar app-fat.jar --main-class edu.ntnu.idatt2003.g23.App --module-path "${project.build.directory}/javafx-mods" --add-modules javafx.controls,javafx.media --java-options '--enable-native-access=javafx.graphics,javafx.media' --java-options '-Dglass.mac.uiScale=1.25' --dest "${java.io.tmpdir}/afterhours-dist" &amp;&amp; rm -rf "${project.build.directory}/dist/After Hours.app" &amp;&amp; cp -R "${java.io.tmpdir}/afterhours-dist/After Hours.app" "${project.build.directory}/dist/"</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!--
      Cross-platform fat JAR profile.
      Keep this out of the default dev classpath so `mvn javafx:run` uses only host-native JavaFX.
      Enable with: -Pportable-jar
    -->
    <profile>
      <id>portable-jar</id>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>linux</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>linux</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
