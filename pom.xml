<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.ntnu.idatt2003.g23</groupId>
  <artifactId>after-hours</artifactId>
  <version>1.3.1</version>

  <name>After Hours</name>
  <url>https://github.com/JoachimVN/After-Hours</url>
  
  <!-- Release process:
       1. Go to GitHub Releases
       2. Click "Draft a new release"
       3. Create a new tag (e.g., v1.0.0, v1.0.0-beta.1)
       4. Choose target branch (usually main/dev)
       5. Click "Generate release notes" (optional)
       6. Click "Publish release"
       Result: Automated workflow builds Windows .exe, portable .zip, updates version, and uploads assets.
  -->

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <javafx.platform.classifier>win</javafx.platform.classifier>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>25.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>25.0.1</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- All resources unfiltered (avoids corrupting binary files like images) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <!-- version.properties filtered so ${project.version} is substituted at build time -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>version.properties</include>
        </includes>
      </resource>
    </resources>

    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
              <source>25</source>
              <target>25</target>
          </configuration>
          </plugin>

            <!-- Surefire (JUnit 5 support is built-in) -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.5.4</version>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <version>3.12.0</version>
            </plugin>

            <!-- Development: mvn javafx:run -->
            <plugin>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-maven-plugin</artifactId>
              <version>0.0.8</version>
              <configuration>
                <mainClass>edu.ntnu.idatt2003.g23.App</mainClass>
                <options>
                  <option>--enable-native-access=javafx.graphics,javafx.media</option>
                  <option>-Dglass.win.uiScale=1.25</option>
                  <option>-Dglass.gtk.uiScale=1.25</option>
                  <option>-Dglass.mac.uiScale=1.25</option>
                </options>
              </configuration>
            </plugin>
      </plugins>
    </pluginManagement>

    <!-- Plugins that are actively bound to lifecycle phases or run on demand -->
    <plugins>

      <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>edu.ntnu.idatt2003.g23.Launcher</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                </manifestEntries>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

      <!--
        Distribution exe: native installer via jpackage.
        Produces a native package for the current OS.
        The installer bundles a JRE; recipients need nothing pre-installed.

        Run after mvn package with one of:
        - mvn exec:exec@jpackage       (Windows EXE)
        - mvn exec:exec@jpackage-linux (Linux app-image)
        - mvn exec:exec@jpackage-mac   (macOS app-image)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>jpackage</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>exe</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.ico</argument>
                <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.win.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                <argument>--win-dir-chooser</argument>
                <argument>--win-shortcut</argument>
                <argument>--win-shortcut-prompt</argument>
                <argument>--win-menu</argument>
                <argument>--win-menu-group</argument><argument>After Hours</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-linux</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>app-image</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.png</argument>
                <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.gtk.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-mac</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>-c</argument>
                <argument>rm -rf "${java.io.tmpdir}/afterhours-dist/After Hours.app" &amp;&amp; jpackage --type app-image --name "After Hours" --app-version ${project.version} --vendor NTNU --description "After Hours" --icon "${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.icns" --input "${project.build.directory}/jpackage-input" --main-jar app-fat.jar --main-class edu.ntnu.idatt2003.g23.App --module-path "${project.build.directory}/javafx-mods" --add-modules javafx.controls,javafx.media --java-options '--enable-native-access=javafx.graphics,javafx.media' --java-options '-Dglass.mac.uiScale=1.25' --dest "${java.io.tmpdir}/afterhours-dist" &amp;&amp; rm -rf "${project.build.directory}/dist/After Hours.app" &amp;&amp; cp -R "${java.io.tmpdir}/afterhours-dist/After Hours.app" "${project.build.directory}/dist/"</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!--
      Cross-platform fat JAR profile.
      Keep this out of the default dev classpath so `mvn javafx:run` uses only host-native JavaFX.
      Enable with: -Pportable-jar
    -->
    <profile>
      <id>portable-jar</id>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>linux</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>25.0.1</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>linux</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>25.0.1</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
      </dependencies>
    </profile>

    <!--
      Windows EXE installer via jpackage.
      Requires WiX Toolset v3 on PATH (https://wixtoolset.org/).
      Bundles a JRE — recipients need nothing pre-installed.

      Enable with: -Pexe
    -->
    <profile>
      <id>exe</id>
      <build>
        <plugins>
          <!-- Strip pre-release suffix from project.version for jpackage (e.g. 1.3.0-beta.2 → 1.3.0) -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>strip-version-qualifier</id>
                <phase>validate</phase>
                <goals><goal>regex-property</goal></goals>
                <configuration>
                  <name>jpackage.version</name>
                  <value>${project.version}</value>
                  <regex>^(\d+\.\d+\.\d+).*$</regex>
                  <replacement>$1</replacement>
                  <failIfNoMatch>false</failIfNoMatch>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Step 1: copy Windows modular JavaFX JARs into target/javafx-mods -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>copy-javafx-mods</id>
                <phase>package</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>25.0.1</version><classifier>win</classifier>
                      <destFileName>javafx-base-25.0.1-win.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>25.0.1</version><classifier>win</classifier>
                      <destFileName>javafx-graphics-25.0.1-win.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>25.0.1</version><classifier>win</classifier>
                      <destFileName>javafx-controls-25.0.1-win.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-media</artifactId>
                      <version>25.0.1</version><classifier>win</classifier>
                      <destFileName>javafx-media-25.0.1-win.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}/javafx-mods</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Step 2: stage fat JAR then run jpackage -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>build-exe</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/jpackage-input"/>
                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
                          tofile="${project.build.directory}/jpackage-input/app-fat.jar"/>
                    <exec executable="jpackage" failonerror="true">
                      <arg value="--type"/><arg value="exe"/>
                      <arg value="--name"/><arg value="After Hours"/>
                      <arg value="--app-version"/><arg value="${jpackage.version}"/>
                      <arg value="--vendor"/><arg value="NTNU"/>
                      <arg value="--description"/><arg value="After Hours"/>
                      <arg value="--icon"/>
                      <arg value="${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.ico"/>
                      <arg value="--input"/><arg value="${project.build.directory}/jpackage-input"/>
                      <arg value="--main-jar"/><arg value="app-fat.jar"/>
                      <arg value="--main-class"/><arg value="edu.ntnu.idatt2003.g23.App"/>
                      <arg value="--module-path"/><arg value="${project.build.directory}/javafx-mods"/>
                      <arg value="--add-modules"/><arg value="javafx.controls,javafx.media"/>
                      <arg value="--java-options"/><arg value="--enable-native-access=javafx.graphics,javafx.media"/>
                      <arg value="--java-options"/><arg value="-Dglass.win.uiScale=1.25"/>
                      <arg value="--dest"/><arg value="${project.build.directory}/dist"/>
                      <arg value="--win-dir-chooser"/>
                      <arg value="--win-shortcut"/>
                      <arg value="--win-shortcut-prompt"/>
                      <arg value="--win-menu"/>
                      <arg value="--win-menu-group"/><arg value="After Hours"/>
                    </exec>
                    <!-- Rename to include full project version (e.g. After Hours-1.3.0-beta.2.exe) -->
                    <!-- Only rename when the qualifier makes the versions differ (e.g. pre-release) -->
                    <condition property="exe.rename.needed">
                      <not>
                        <equals arg1="${jpackage.version}" arg2="${project.version}"/>
                      </not>
                    </condition>
                    <move file="${project.build.directory}/dist/After Hours-${jpackage.version}.exe"
                          tofile="${project.build.directory}/dist/After Hours-${project.version}.exe"
                          failonerror="true"
                          xmlns:if="ant:if"
                          if:set="exe.rename.needed"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Linux app-image via jpackage, zipped for distribution.
      Enable with: -Plinux
    -->
    <profile>
      <id>linux</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>strip-version-qualifier</id>
                <phase>validate</phase>
                <goals><goal>regex-property</goal></goals>
                <configuration>
                  <name>jpackage.version</name>
                  <value>${project.version}</value>
                  <regex>^(\d+\.\d+\.\d+).*$</regex>
                  <replacement>$1</replacement>
                  <failIfNoMatch>false</failIfNoMatch>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>copy-javafx-mods-linux</id>
                <phase>package</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>25.0.1</version><classifier>linux</classifier>
                      <destFileName>javafx-base-25.0.1-linux.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>25.0.1</version><classifier>linux</classifier>
                      <destFileName>javafx-graphics-25.0.1-linux.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>25.0.1</version><classifier>linux</classifier>
                      <destFileName>javafx-controls-25.0.1-linux.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-media</artifactId>
                      <version>25.0.1</version><classifier>linux</classifier>
                      <destFileName>javafx-media-25.0.1-linux.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}/javafx-mods</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>build-linux</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/jpackage-input"/>
                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
                          tofile="${project.build.directory}/jpackage-input/app-fat.jar"/>
                    <exec executable="jpackage" failonerror="true">
                      <arg value="--type"/><arg value="app-image"/>
                      <arg value="--name"/><arg value="After Hours"/>
                      <arg value="--app-version"/><arg value="${jpackage.version}"/>
                      <arg value="--vendor"/><arg value="NTNU"/>
                      <arg value="--description"/><arg value="After Hours"/>
                      <arg value="--icon"/>
                      <arg value="${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.png"/>
                      <arg value="--input"/><arg value="${project.build.directory}/jpackage-input"/>
                      <arg value="--main-jar"/><arg value="app-fat.jar"/>
                      <arg value="--main-class"/><arg value="edu.ntnu.idatt2003.g23.App"/>
                      <arg value="--module-path"/><arg value="${project.build.directory}/javafx-mods"/>
                      <arg value="--add-modules"/><arg value="javafx.controls,javafx.media"/>
                      <arg value="--java-options"/><arg value="--enable-native-access=javafx.graphics,javafx.media"/>
                      <arg value="--java-options"/><arg value="-Dglass.gtk.uiScale=1.25"/>
                      <arg value="--dest"/><arg value="${project.build.directory}/dist"/>
                    </exec>
                    <zip destfile="${project.build.directory}/dist/After Hours-${project.version}-linux.zip">
                      <zipfileset dir="${project.build.directory}/dist/After Hours" prefix="After Hours"/>
                    </zip>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      macOS DMG via jpackage (Apple Silicon).
      Enable with: -Pmac
    -->
    <profile>
      <id>mac</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>strip-version-qualifier</id>
                <phase>validate</phase>
                <goals><goal>regex-property</goal></goals>
                <configuration>
                  <name>jpackage.version</name>
                  <value>${project.version}</value>
                  <regex>^(\d+\.\d+\.\d+).*$</regex>
                  <replacement>$1</replacement>
                  <failIfNoMatch>false</failIfNoMatch>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>copy-javafx-mods-mac</id>
                <phase>package</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                      <version>25.0.1</version><classifier>mac-aarch64</classifier>
                      <destFileName>javafx-base-25.0.1-mac-aarch64.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                      <version>25.0.1</version><classifier>mac-aarch64</classifier>
                      <destFileName>javafx-graphics-25.0.1-mac-aarch64.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                      <version>25.0.1</version><classifier>mac-aarch64</classifier>
                      <destFileName>javafx-controls-25.0.1-mac-aarch64.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.openjfx</groupId><artifactId>javafx-media</artifactId>
                      <version>25.0.1</version><classifier>mac-aarch64</classifier>
                      <destFileName>javafx-media-25.0.1-mac-aarch64.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}/javafx-mods</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>build-mac</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/jpackage-input"/>
                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
                          tofile="${project.build.directory}/jpackage-input/app-fat.jar"/>
                    <exec executable="jpackage" failonerror="true">
                      <arg value="--type"/><arg value="dmg"/>
                      <arg value="--name"/><arg value="After Hours"/>
                      <arg value="--app-version"/><arg value="${jpackage.version}"/>
                      <arg value="--vendor"/><arg value="NTNU"/>
                      <arg value="--description"/><arg value="After Hours"/>
                      <arg value="--icon"/>
                      <arg value="${project.basedir}/src/main/resources/images/logos/After_Hours_Logo_Square.icns"/>
                      <arg value="--input"/><arg value="${project.build.directory}/jpackage-input"/>
                      <arg value="--main-jar"/><arg value="app-fat.jar"/>
                      <arg value="--main-class"/><arg value="edu.ntnu.idatt2003.g23.App"/>
                      <arg value="--module-path"/><arg value="${project.build.directory}/javafx-mods"/>
                      <arg value="--add-modules"/><arg value="javafx.controls,javafx.media"/>
                      <arg value="--java-options"/><arg value="--enable-native-access=javafx.graphics,javafx.media"/>
                      <arg value="--java-options"/><arg value="-Dglass.mac.uiScale=1.25"/>
                      <arg value="--dest"/><arg value="${project.build.directory}/dist"/>
                    </exec>
                    <!-- Rename to include full project version (e.g. After Hours-1.3.0-beta.2.dmg) -->
                    <!-- Only rename when the qualifier makes the versions differ (e.g. pre-release) -->
                    <condition property="dmg.rename.needed">
                      <not>
                        <equals arg1="${jpackage.version}" arg2="${project.version}"/>
                      </not>
                    </condition>
                    <move file="${project.build.directory}/dist/After Hours-${jpackage.version}.dmg"
                          tofile="${project.build.directory}/dist/After Hours-${project.version}.dmg"
                          failonerror="true"
                          xmlns:if="ant:if"
                          if:set="dmg.rename.needed"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
