<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.ntnu.idatt2003.g23</groupId>
  <artifactId>app</artifactId>
  <version>1.0</version>

  <name>app</name>
  <!-- FIXME change it to the project's website -->
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <javafx.platform.classifier>win</javafx.platform.classifier>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>25.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>25.0.1</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.0.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
              <source>25</source>
              <target>25</target>
          </configuration>
          </plugin>

            <!-- Surefire (JUnit 5 support is built-in) -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.5.4</version>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc.plugin</artifactId>
              <version>3.12.0</version>
            </plugin>

            <!-- Development: mvn javafx:run -->
            <plugin>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-maven-plugin</artifactId>
              <version>0.0.8</version>
              <configuration>
                <mainClass>edu.ntnu.idatt2003.g23.App</mainClass>
                <options>
                  <option>--enable-native-access=javafx.graphics,javafx.media</option>
                  <option>-Dglass.win.uiScale=1.25</option>
                  <option>-Dglass.gtk.uiScale=1.25</option>
                  <option>-Dglass.mac.uiScale=1.25</option>
                </options>
              </configuration>
            </plugin>
      </plugins>
    </pluginManagement>

    <!-- Plugins that are actively bound to lifecycle phases or run on demand -->
    <plugins>

      <!--
        Distribution step 1: fat JAR.
        Bundles Gson and all non-JavaFX deps into target/app-fat.jar.
        JavaFX is excluded — it contains native libs that cannot be shaded.
        Runs during: mvn package
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/app-fat.jar</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>edu.ntnu.idatt2003.g23.App</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>org.openjfx:*</artifact>
                  <excludes><exclude>**</exclude></excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Distribution step 2: copy platform-specific JavaFX JARs to target/javafx-mods/.
        jpackage needs these on its module-path.
        The classifier is selected from the active OS profile.
        Runs during: mvn package
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-javafx-mods</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/javafx-mods</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId>
                  <version>25.0.1</version><classifier>${javafx.platform.classifier}</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId>
                  <version>25.0.1</version><classifier>${javafx.platform.classifier}</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId>
                  <version>25.0.1</version><classifier>${javafx.platform.classifier}</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-media</artifactId>
                  <version>25.0.1</version><classifier>${javafx.platform.classifier}</classifier></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Distribution step 2.5: always copy a runnable JAR to target/dist/.
        This is the cross-platform artifact your teacher asked for.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-dist-jar</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/dist"/>
                <copy file="${project.build.directory}/app-fat.jar"
                      tofile="${project.build.directory}/dist/AfterHours.jar"/>
                <copy file="${project.basedir}/src/main/scripts/AfterHours.bat"
                      todir="${project.build.directory}/dist"/>
                <copy file="${project.basedir}/src/main/scripts/AfterHours.sh"
                      todir="${project.build.directory}/dist"/>
                <chmod file="${project.build.directory}/dist/AfterHours.sh" perm="755"/>
                <copy todir="${project.build.directory}/dist/javafx-mods">
                  <fileset dir="${project.build.directory}/javafx-mods"/>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Distribution step 3: native installer via jpackage.
        Produces a native package for the current OS.
        The installer bundles a JRE; recipients need nothing pre-installed.

        Run after mvn package with one of:
        - mvn exec:exec@jpackage       (Windows EXE)
        - mvn exec:exec@jpackage-linux (Linux app-image)
        - mvn exec:exec@jpackage-mac   (macOS app-image)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>jpackage</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>exe</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours stock trading game</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo.ico</argument>
                <argument>--input</argument><argument>${project.build.directory}</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.win.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                <argument>--win-dir-chooser</argument>
                <argument>--win-shortcut</argument>
                <argument>--win-shortcut-prompt</argument>
                <argument>--win-menu</argument>
                <argument>--win-menu-group</argument><argument>After Hours</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-linux</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>app-image</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours stock trading game</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo.png</argument>
                <argument>--input</argument><argument>${project.build.directory}</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.gtk.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-mac</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>jpackage</executable>
              <arguments>
                <argument>--type</argument><argument>app-image</argument>
                <argument>--name</argument><argument>After Hours</argument>
                <argument>--app-version</argument><argument>${project.version}</argument>
                <argument>--vendor</argument><argument>NTNU</argument>
                <argument>--description</argument><argument>After Hours stock trading game</argument>
                <argument>--icon</argument>
                <argument>${project.basedir}/src/main/resources/images/logos/After_Hours_Logo.png</argument>
                <argument>--input</argument><argument>${project.build.directory}</argument>
                <argument>--main-jar</argument><argument>app-fat.jar</argument>
                <argument>--main-class</argument><argument>edu.ntnu.idatt2003.g23.App</argument>
                <argument>--module-path</argument>
                <argument>${project.build.directory}/javafx-mods</argument>
                <argument>--add-modules</argument>
                <argument>javafx.controls,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--java-options</argument>
                <argument>-Dglass.mac.uiScale=1.25</argument>
                <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform.classifier>win</javafx.platform.classifier>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <activation>
        <os>
          <family>unix</family>
          <name>Linux</name>
        </os>
      </activation>
      <properties>
        <javafx.platform.classifier>linux</javafx.platform.classifier>
      </properties>
    </profile>
    <profile>
      <id>mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <javafx.platform.classifier>mac</javafx.platform.classifier>
      </properties>
    </profile>
  </profiles>
</project>
